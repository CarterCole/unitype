{
  "name": "demo",
  "doc": "Shapes, and the things done to them.",
  "types": [
    {
      "k": "interface",
      "name": "Identified",
      "doc": "Anything that can be told apart from another of its kind.",
      "fields": [{ "name": "id", "ty": "str" }]
    },
    {
      "k": "struct",
      "name": "Shape",
      "implements": ["Identified"],
      "fields": [{ "name": "id", "ty": "str" }]
    },
    {
      "k": "struct",
      "name": "Circle",
      "extends": "Shape",
      "fields": [
        {
          "name": "kind",
          "doc": "The discriminator, pinned to one value so a union can be told apart.",
          "ty": { "k": "literal", "value": { "str": "circle" } }
        },
        { "name": "radius", "ty": "float" }
      ]
    },
    {
      "k": "struct",
      "name": "Rect",
      "extends": "Shape",
      "fields": [
        {
          "name": "kind",
          "ty": { "k": "literal", "value": { "str": "rect" } }
        },
        { "name": "width", "ty": "float" },
        { "name": "height", "ty": "float" }
      ]
    },
    {
      "k": "alias",
      "name": "AnyShape",
      "doc": "Either kind, told apart by `kind`.",
      "target": { "k": "union", "members": ["Circle", "Rect"] }
    },
    {
      "k": "struct",
      "name": "Run",
      "doc": "How far through a list a check has got: whether everything so far was in order, and the last element seen.",
      "fields": [
        { "name": "ok", "ty": "bool" },
        { "name": "prev", "ty": "int" },
        { "name": "started", "ty": "bool" }
      ]
    },
    {
      "k": "struct",
      "name": "Label",
      "fields": [
        { "name": "text", "ty": "str" },
        { "name": "sides", "ty": "i64" }
      ]
    }
  ],
  "functions": [
    {
      "name": "sort",
      "doc": "Puts a list of integers in order. Says nothing about how, which is the point: several proofs of this exist and they differ in what they cost.",
      "params": [{ "name": "xs", "ty": "[int]" }],
      "ret": "[int]"
    },
    {
      "name": "mergesort",
      "doc": "Sorting, but specifically by merging. A proof of this is also a proof of `sort`, so registering one here answers calls to either.",
      "refines": "demo::sort",
      "params": [{ "name": "xs", "ty": "[int]" }],
      "ret": "[int]"
    },
    {
      "name": "reverse",
      "doc": "Turns a list around. Generic, which says more than it looks like it does: a proof of this may not look at the elements, so the harness can hold it to that without being told a single expected answer.",
      "params_decl": [{ "name": "T" }],
      "params": [{ "name": "xs", "ty": { "k": "list", "of": { "k": "param", "name": "T" } } }],
      "ret": { "k": "list", "of": { "k": "param", "name": "T" } }
    },
    {
      "name": "sum",
      "doc": "Adds a list up. A fold carries the total from one element to the next, which is all the recursion a sum needs and all this language allows.",
      "params": [{ "name": "xs", "ty": "[int]" }],
      "ret": "int",
      "body": {
        "k": "fold", "list": { "k": "var", "name": "xs" }, "init": { "k": "lit", "value": 0 },
        "acc": "total", "item": "x",
        "body": { "k": "prim", "op": "add", "args": [{ "k": "var", "name": "total" }, { "k": "var", "name": "x" }] }
      }
    },
    {
      "name": "count",
      "doc": "How many times a value appears in a list.",
      "params": [{ "name": "xs", "ty": "[int]" }, { "name": "x", "ty": "int" }],
      "ret": "int",
      "body": {
        "k": "fold", "list": { "k": "var", "name": "xs" }, "init": { "k": "lit", "value": 0 },
        "acc": "n", "item": "y",
        "body": {
          "k": "if",
          "cond": { "k": "prim", "op": "eq", "args": [{ "k": "var", "name": "y" }, { "k": "var", "name": "x" }] },
          "then": { "k": "prim", "op": "add", "args": [{ "k": "var", "name": "n" }, { "k": "lit", "value": 1 }] },
          "else": { "k": "var", "name": "n" }
        }
      }
    },
    {
      "name": "sorted",
      "doc": "Whether a list is in order. Not a sort: a check that one happened, which needs no recursion, only a walk along the list remembering the last element.",
      "params": [{ "name": "xs", "ty": "[int]" }],
      "ret": "bool",
      "body": {
        "k": "field", "name": "ok",
        "of": {
          "k": "fold", "list": { "k": "var", "name": "xs" },
          "init": {
            "k": "make_record", "ty": "Run",
            "fields": [
              { "name": "ok", "value": { "k": "lit", "value": true } },
              { "name": "prev", "value": { "k": "lit", "value": 0 } },
              { "name": "started", "value": { "k": "lit", "value": false } }
            ]
          },
          "acc": "run", "item": "x",
          "body": {
            "k": "make_record", "ty": "Run",
            "fields": [
              {
                "name": "ok",
                "value": {
                  "k": "prim", "op": "and",
                  "args": [
                    { "k": "field", "of": { "k": "var", "name": "run" }, "name": "ok" },
                    {
                      "k": "prim", "op": "or",
                      "args": [
                        { "k": "prim", "op": "not", "args": [{ "k": "field", "of": { "k": "var", "name": "run" }, "name": "started" }] },
                        { "k": "prim", "op": "le", "args": [{ "k": "field", "of": { "k": "var", "name": "run" }, "name": "prev" }, { "k": "var", "name": "x" }] }
                      ]
                    }
                  ]
                }
              },
              { "name": "prev", "value": { "k": "var", "name": "x" } },
              { "name": "started", "value": { "k": "lit", "value": true } }
            ]
          }
        }
      }
    },
    {
      "name": "label_of",
      "doc": "Describes a rectangle. Written as a body rather than implemented, so it needs nobody to prove it and runs in every language once generated.",
      "params": [{ "name": "r", "ty": "Rect" }],
      "ret": "Label",
      "body": {
        "k": "make_record",
        "ty": "Label",
        "fields": [
          {
            "name": "text",
            "value": { "k": "field", "of": { "k": "var", "name": "r" }, "name": "id" }
          },
          { "name": "sides", "value": { "k": "lit", "value": 4 } }
        ]
      }
    }
  ]
}
